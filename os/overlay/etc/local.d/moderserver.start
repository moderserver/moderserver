set -eu

echo "===MODERSERVER_BOOT_STARTED===" > /dev/ttyS0

# Prevent multiple executions
if [ -f /tmp/moderserver-boot.done ]; then
  exit 0
fi
touch /tmp/moderserver-boot.done

# 1. Set valid system hostname
hostname moderserver
echo "moderserver" > /etc/hostname

# 2. Mount kernel modules
if [ ! -d /lib/modules ] || [ -z "$(ls -A /lib/modules 2>/dev/null)" ]; then
  mkdir -p /.modloop /lib/modules
  mount -o loop,ro /media/cdrom/boot/modloop-virt /.modloop 2>/dev/null || true
  if [ -d /.modloop/modules ]; then
    mount --bind /.modloop/modules /lib/modules 2>/dev/null || true
  fi
fi
modprobe ext4 >/dev/null 2>&1 || true
modprobe overlay >/dev/null 2>&1 || true
modprobe br_netfilter >/dev/null 2>&1 || true

# 3. Bring up loopback and dynamic interface networking via DHCP
ip link set lo up >/dev/null 2>&1 || true
for iface in $(ls /sys/class/net 2>/dev/null); do
  if [ "${iface}" != "lo" ] && [ ! -d "/sys/class/net/${iface}/wireless" ]; then
    ip link set "${iface}" up >/dev/null 2>&1 || true
    udhcpc -i "${iface}" -s /usr/share/udhcpc/default.script -t 3 -q >/dev/null 2>&1 || true
  fi
done

# 4. Install pre-baked runtime packages from local ISO
echo "--> Installing host prerequisites from ISO..." > /dev/ttyS0
apk add --no-network --allow-untrusted --force-non-repository /media/cdrom/root/bootstrap/apks/*.apk > /dev/ttyS0 2>&1 || true
rm -rf /var/cache/apk/* /tmp/* 2>/dev/null || true

# Format and mount storage disk at /var/lib/rancher if available
TARGET_DISK=""
for dev in /sys/block/*; do
  [ -e "${dev}" ] || continue
  dev_name=$(basename "${dev}")
  case "${dev_name}" in
    loop*|sr*|ram*|fd*|zram*|dm-*) continue ;;
    *)
      if [ -b "/dev/${dev_name}" ]; then
        TARGET_DISK="/dev/${dev_name}"
        break
      fi
      ;;
  esac
done

if [ -n "${TARGET_DISK}" ] && [ -b "${TARGET_DISK}" ]; then
  if [ -z "$(/sbin/blkid "${TARGET_DISK}" 2>/dev/null)" ]; then
    echo "--> Formatting storage disk ${TARGET_DISK}..." > /dev/ttyS0
    mkfs.ext4 -F -q "${TARGET_DISK}" > /dev/ttyS0 2>&1 || true
  fi
  mkdir -p /var/lib/rancher
  mount_err=$(mount "${TARGET_DISK}" /var/lib/rancher 2>&1 || true)
  if [ -z "${mount_err}" ]; then
    echo "--> Successfully mounted storage disk ${TARGET_DISK} at /var/lib/rancher" > /dev/ttyS0
  else
    echo "--> ERROR: Failed to mount storage disk ${TARGET_DISK} at /var/lib/rancher: ${mount_err}" > /dev/ttyS0
  fi
fi

# Pre-load platform container images into K3s containerd
if [ -d /media/cdrom/root/bootstrap/images ]; then
  echo "--> Staging pre-baked platform container images..." > /dev/ttyS0
  mkdir -p /var/lib/rancher/k3s/agent/images
  cp -f /media/cdrom/root/bootstrap/images/*.tar /var/lib/rancher/k3s/agent/images/ 2>/dev/null || true
fi

# Pre-load platform GitOps bootstrap manifests into K3s server auto-deploy
if [ -d /media/cdrom/root/bootstrap/manifests ]; then
  echo "--> Staging platform GitOps bootstrap manifests..." > /dev/ttyS0
  mkdir -p /var/lib/rancher/k3s/server/manifests
  cp -f /media/cdrom/root/bootstrap/manifests/*.yaml /var/lib/rancher/k3s/server/manifests/ 2>/dev/null || true

  # Check if hypervisor passed a dev GitOps mirror URL via SMBIOS serial (e.g. QEMU local dev)
  if [ -f /sys/class/dmi/id/product_serial ]; then
    DMI_SERIAL=$(cat /sys/class/dmi/id/product_serial 2>/dev/null || true)
    if echo "${DMI_SERIAL}" | grep -q "^git://"; then
      echo "--> Applying local dev GitOps mirror from hypervisor: ${DMI_SERIAL}" > /dev/ttyS0
      sed -i -E "s#repoURL: .*#repoURL: \"${DMI_SERIAL}\"#" /var/lib/rancher/k3s/server/manifests/02-root.yaml || true
      sed -i -E "s#localDev: false#localDev: true#" /var/lib/rancher/k3s/server/manifests/02-root.yaml || true
    fi
  fi
fi

# 5. Run ModerServer host bootstrap
if [ -f /media/cdrom/root/bootstrap/setup-host.sh ]; then
  echo "--> Running ModerServer host bootstrap..." > /dev/ttyS0
  /bin/sh /media/cdrom/root/bootstrap/setup-host.sh > /dev/ttyS0 2>&1 || true
fi

# 6. Mount cgroups and start K3s
mkdir -p /sys/fs/cgroup
mount -t cgroup2 none /sys/fs/cgroup 2>/dev/null || true
rc-service cgroups start >/dev/null 2>&1 || true

if [ -x /etc/init.d/k3s ]; then
  rc-service k3s start >/dev/null 2>&1 || nohup /usr/local/bin/k3s server > /var/log/k3s.log 2>&1 &
elif [ -x /usr/local/bin/k3s ]; then
  nohup /usr/local/bin/k3s server > /var/log/k3s.log 2>&1 &
fi

# 7. Wait until K3s generates kubeconfig and emit over serial
echo "--> Waiting for K3s initialization..." > /dev/ttyS0
until [ -s /etc/rancher/k3s/k3s.yaml ]; do
  sleep 1
done
sleep 2

# 8. Emit kubeconfig over serial
echo "===BEGIN_MODERSERVER_KUBECONFIG===" > /dev/ttyS0
cat /etc/rancher/k3s/k3s.yaml > /dev/ttyS0
echo "===END_MODERSERVER_KUBECONFIG===" > /dev/ttyS0
