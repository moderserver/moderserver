# syntax=docker/dockerfile:1
###############################################
# ModerServer Argo CD Server
# Purpose: Web UI, REST, and gRPC API server for Argo CD
###############################################

# renovate: datasource=docker depName=quay.io/argoproj/argocd
ARG ARGOCD_VERSION=v3.6.1
# renovate: datasource=docker depName=alpine
ARG ALPINE_VERSION=3.24.4

FROM quay.io/argoproj/argocd:${ARGOCD_VERSION} AS argocd-bin
FROM alpine:${ALPINE_VERSION}

LABEL org.opencontainers.image.title="ModerServer Argo CD Server" \
      org.opencontainers.image.description="Web UI and API server for Argo CD" \
      org.opencontainers.image.vendor="ModerServer" \
      org.opencontainers.image.licenses="Apache-2.0"

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates tzdata && \
    mkdir -p /app/config/tls /app/config/ssh /home/argocd /tmp && \
    chown -R 65534:65534 /app /home/argocd /tmp

COPY --from=argocd-bin /usr/local/bin/argocd /usr/local/bin/argocd
RUN ln -s /usr/local/bin/argocd /usr/local/bin/argocd-server

USER 65534:65534
WORKDIR /home/argocd

ENTRYPOINT ["/usr/local/bin/argocd-server"]
