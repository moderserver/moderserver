description="K3s Kubernetes Distribution for ModerServer"
supervisor="supervise-daemon"
command="/usr/local/bin/k3s"
command_args="server"
output_log="/var/log/k3s.log"
error_log="/var/log/k3s.log"

depend() {
    need net cgroups
    after firewall
}

start_pre() {
    # Ensure necessary kernel modules are loaded
    modprobe -q overlay || true
    modprobe -q br_netfilter || true

    # Ensure required cgroup hierarchies are mounted
    if [ ! -d /sys/fs/cgroup ]; then
        eerror "cgroups hierarchy /sys/fs/cgroup not found. Ensure the cgroups service is enabled."
        return 1
    fi

    # Ensure directory structure exists
    mkdir -p /etc/rancher/k3s /var/lib/rancher/k3s /var/log
}
