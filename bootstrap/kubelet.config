apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration

# CIS 4.2.1 & 4.2.2: Kubelet Authentication & Authorization
authentication:
  anonymous:
    enabled: false
  webhook:
    enabled: true
authorization:
  mode: Webhook

# CIS 4.2.4: Disable unauthenticated read-only port 10255
readOnlyPort: 0

# CIS 4.2.6: Enforce host kernel parameter adherence
protectKernelDefaults: true

# Timeouts & Log Rotation
streamingConnectionIdleTimeout: 5m
maxPods: 110
containerLogMaxSize: 10Mi
containerLogMaxFiles: 3

# Rotate serving certificates automatically
rotateCertificates: true
