apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration

# CIS 4.2.1 & 4.2.2: Kubelet Authentication & Authorization
authentication:
  anonymous:
    enabled: false
  webhook:
    enabled: true
authorization:
  mode: Webhook

# CIS 4.2.4: Disable unauthenticated read-only port 10255
readOnlyPort: 0

# Kubelet may adjust kernel tunables itself instead of refusing to start
protectKernelDefaults: false

# Timeouts & Log Rotation
streamingConnectionIdleTimeout: 5m
maxPods: 110
containerLogMaxSize: 10Mi
containerLogMaxFiles: 3

# Rotate serving certificates automatically
rotateCertificates: true

# Eviction thresholds: reclaim before the single system disk or RAM is exhausted
evictionHard:
  memory.available: "100Mi"
  nodefs.available: "5%"
  nodefs.inodesFree: "5%"
  imagefs.available: "5%"
  imagefs.inodesFree: "5%"
